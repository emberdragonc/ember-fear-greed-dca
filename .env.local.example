# Backend Configuration (for DCA execution)
# Alchemy API key for Base mainnet RPC (read operations)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Pimlico API key for ERC-4337 bundler and paymaster
PIMLICO_API_KEY=your_pimlico_api_key_here

# Backend signer private key (DO NOT COMMIT!)
BACKEND_PRIVATE_KEY=0x...
DCA_BACKEND_PRIVATE_KEY=0x...

# Frontend Configuration
NEXT_PUBLIC_BACKEND_SIGNER=0x...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_UNISWAP_API_KEY=your_uniswap_api_key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Chain Configuration
NEXT_PUBLIC_CHAIN_ID=8453
